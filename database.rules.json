{
  "rules": {
    "celeiro_reservas_v3": {
      ".read": true,
      "bloqueio": {
        ".write": true
      },
      "configCasa": {
        ".write": true
      },
      "ocupacao_mesas": {
        "$data": {
          "$mesa": {
            ".write": "!newData.exists() || ($data.matches(/^202[67]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && root.child('celeiro_reservas_v3/bloqueio/datasTrancadas/' + $data).val() !== true && root.child('celeiro_reservas_v3/configCasa/datasTrancadas/' + $data).val() !== true && (root.child('celeiro_reservas_v3/bloqueio/datasLiberadas/' + $data).val() === true || root.child('celeiro_reservas_v3/configCasa/datasLiberadas/' + $data).val() === true || $data.matches(/^(2026-01-(01|04|11|18|25)|2026-02-(01|08|15|17|22)|2026-03-(01|08|15|22|29)|2026-04-(03|05|12|19|21|26)|2026-05-(01|03|10|17|24|31)|2026-06-(04|07|14|21|28)|2026-07-(05|09|12|19|26)|2026-08-(01|02|09|16|23|30)|2026-09-(06|07|13|20|27)|2026-10-(04|11|12|18|25)|2026-11-(01|02|08|15|20|22|29)|2026-12-(06|13|20|25|27)|2027-01-(01|03|10|17|24|31)|2027-02-(07|09|14|21|28)|2027-03-(07|14|21|26|28)|2027-04-(04|11|18|21|25)|2027-05-(01|02|09|16|23|27|30)|2027-06-(06|13|20|27)|2027-07-(04|09|11|18|25)|2027-08-(01|08|15|22|29)|2027-09-(05|07|12|19|26)|2027-10-(03|10|12|17|24|31)|2027-11-(02|07|14|15|20|21|28)|2027-12-(05|12|19|25|26))$/)) && (!data.exists() || data.child('reservaId').val() === newData.child('reservaId').val() || data.child('status').val() === 'cancelada'))"
          }
        }
      },
      "reservas": {
        "$id": {
          ".write": "!newData.exists() || newData.child('status').val() === 'cancelada' || newData.child('status').val() === 'cancelado' || (data.exists() && newData.child('data').val() === data.child('data').val()) || (newData.hasChildren(['nome', 'data', 'horario', 'mesa']) && newData.child('data').isString() && newData.child('data').val().matches(/^202[67]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && newData.child('horario').val().matches(/^(11:30|11:45|12:00)$/) && root.child('celeiro_reservas_v3/bloqueio/datasTrancadas/' + newData.child('data').val()).val() !== true && root.child('celeiro_reservas_v3/configCasa/datasTrancadas/' + newData.child('data').val()).val() !== true && (root.child('celeiro_reservas_v3/bloqueio/datasLiberadas/' + newData.child('data').val()).val() === true || root.child('celeiro_reservas_v3/configCasa/datasLiberadas/' + newData.child('data').val()).val() === true || newData.child('data').val().matches(/^(2026-01-(01|04|11|18|25)|2026-02-(01|08|15|17|22)|2026-03-(01|08|15|22|29)|2026-04-(03|05|12|19|21|26)|2026-05-(01|03|10|17|24|31)|2026-06-(04|07|14|21|28)|2026-07-(05|09|12|19|26)|2026-08-(01|02|09|16|23|30)|2026-09-(06|07|13|20|27)|2026-10-(04|11|12|18|25)|2026-11-(01|02|08|15|20|22|29)|2026-12-(06|13|20|25|27)|2027-01-(01|03|10|17|24|31)|2027-02-(07|09|14|21|28)|2027-03-(07|14|21|26|28)|2027-04-(04|11|18|21|25)|2027-05-(01|02|09|16|23|27|30)|2027-06-(06|13|20|27)|2027-07-(04|09|11|18|25)|2027-08-(01|08|15|22|29)|2027-09-(05|07|12|19|26)|2027-10-(03|10|12|17|24|31)|2027-11-(02|07|14|15|20|21|28)|2027-12-(05|12|19|25|26))$/)))"
        }
      }
    }
  }
}
